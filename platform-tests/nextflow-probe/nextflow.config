// Default image for every task: Google's Cloud SDK (bq, gcloud, curl, python3), pulled
// from Google's registry so it should work even without outside internet.
process.container = 'gcr.io/google.com/cloudsdktool/google-cloud-cli:slim'

params.region = 'us-central1'   // must match the workspace region

profiles {
    // For `wb nextflow run` from a Workbench terminal (Verily's CLI guide). Runs launched
    // from the Workflows page get these settings from Workbench and don't need it.
    'google-batch' {
        process.executor = 'google-batch'
        // workDir: pass -w gs://<bucket>/<path> (make nextflow-probe does)
        google.location = params.region
        google.project = System.getenv('GOOGLE_CLOUD_PROJECT')
        google.batch.serviceAccountEmail = System.getenv('GOOGLE_SERVICE_ACCOUNT_EMAIL')
        google.batch.usePrivateAddress = true
        google.batch.network = 'global/networks/network'
        google.batch.subnetwork = "regions/${params.region}/subnetworks/subnetwork"
        google.batch.installGpuDrivers = true
        google.batch.bootDiskSize = '50 GB'
    }
}
